# Copy to .env for local dev. Every field has a working default except the
# real-integration credentials, which are optional -- the app runs fully
# demoable with none of them set (SQLite + template-fallback narratives +
# mock connectors).

ENVIRONMENT=dev
LOG_LEVEL=INFO
CORS_ORIGINS=

# --- Persistence ---
# Local default; in staging/prod point this at Supabase's POOLED
# (PgBouncer, transaction mode, port 6543) connection string, e.g.
# postgresql+asyncpg://postgres.<project-ref>:<password>@<host>:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./occj.db
SQL_ECHO=false

# --- Supabase (only needed if the backend itself calls Supabase's
# management/REST API -- the frontend talks to Supabase Realtime directly) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM: Groq (OpenAI-compatible) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3-32b

# --- Freshdesk (contact-centre evidence source + customer notification channel) ---
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=

# --- Freshservice (ITSM: incident correlation + escalation) ---
FRESHSERVICE_DOMAIN=
FRESHSERVICE_API_KEY=

# --- Auth ---
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRY_MINUTES=480

# --- Business rules ---
HIGH_VALUE_APPROVAL_THRESHOLD_USD=75.0
STALE_EVIDENCE_HOURS=48
REEVALUATION_CONFIDENCE_DELTA=0.15
